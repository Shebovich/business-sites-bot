# 2GIS Catalog API — https://dev.2gis.com
# Free tier: 1000 запросов/сутки
DGIS_API_KEY=

# Минск region_id в 2GIS (49 — стандартный для Минска)
DGIS_MINSK_REGION_ID=217

# Сколько кандидатов scout добавляет за один запуск
SCOUT_BATCH_SIZE=2

# Минимальный рейтинг заведения чтобы попасть в очередь
SCOUT_MIN_RATING=4.3

# Минимальное число отзывов чтобы попасть в очередь
SCOUT_MIN_REVIEWS=30

# Максимальное число филиалов (фильтрует сетевые заведения — они не наши клиенты)
SCOUT_MAX_BRANCH_COUNT=2

# ===== TG visual-review bot (Q16) =====

# BotFather → /newbot → копируешь токен сюда
TG_BOT_TOKEN=

# Твой Telegram chat_id (узнать у @userinfobot — пишешь ему "/start")
# Бот игнорирует updates от всех остальных id (Q16.5 single-user auth)
TG_OWNER_CHAT_ID=

# Upstash Redis (https://console.upstash.com) → Create Database → REST
# Free tier: 10000 commands/day, более чем достаточно
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub webhook secret — придумай длинную случайную строку, в репо тоже сохрани
# Settings → Webhooks → Add → secret = это значение
GH_WEBHOOK_SECRET=

# GitHub token для API вызовов из webhook handler / GH Actions
# (на самих GH Actions подставляется автоматически как GITHUB_TOKEN)
GH_TOKEN=
