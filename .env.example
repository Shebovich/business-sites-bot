# ===== TG visual-review bot =====

# BotFather → /newbot → копируешь токен сюда
TG_BOT_TOKEN=

# Твой Telegram chat_id (узнать у @userinfobot — пишешь ему "/start")
# Бот игнорирует updates от всех остальных id (Q16.5 single-user auth)
TG_OWNER_CHAT_ID=

# Опционально: чужие chat_ids (comma-separated) с ролью assistant.
# Они могут собирать input и делать /submit, но не финализировать.
TG_ASSISTANT_CHAT_IDS=

# Upstash Redis (https://console.upstash.com) → Create Database → REST
# Free tier: 10000 commands/day, более чем достаточно
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub webhook secret — придумай длинную случайную строку, в репо тоже сохрани
# Settings → Webhooks → Add → secret = это значение
GH_WEBHOOK_SECRET=

# GitHub token для API вызовов из webhook handler
GH_TOKEN=

# Целевой репозиторий сайтов (где живут issues + _data/{slug}/visual_review_input.json).
# Дефолт — Shebovich/business-sites. Переопределяй только если тестируешь на форке.
GITHUB_REPO=Shebovich/business-sites
