# 2GIS Catalog API — https://dev.2gis.com
# Free tier: 1000 запросов/сутки
DGIS_API_KEY=

# Минск region_id в 2GIS (49 — стандартный для Минска)
DGIS_MINSK_REGION_ID=217

# Сколько кандидатов scout добавляет за один запуск
SCOUT_BATCH_SIZE=2

# Минимальный рейтинг заведения чтобы попасть в очередь
SCOUT_MIN_RATING=4.3

# Минимальное число отзывов чтобы попасть в очередь
SCOUT_MIN_REVIEWS=30

# Максимальное число филиалов (фильтрует сетевые заведения — они не наши клиенты)
SCOUT_MAX_BRANCH_COUNT=2
