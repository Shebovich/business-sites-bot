{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/bot/webhook.mjs": {
      "maxDuration": 30
    },
    "api/github-webhook.mjs": {
      "maxDuration": 10
    },
    "api/task/notify.mjs": {
      "maxDuration": 10
    },
    "api/intent/draft.mjs": {
      "maxDuration": 10
    },
    "api/intent/poll.mjs": {
      "maxDuration": 30
    },
    "api/relay/send.mjs": {
      "maxDuration": 10
    },
    "api/interview/index.mjs": {
      "maxDuration": 10
    },
    "api/claude/qna.mjs": {
      "maxDuration": 10
    }
  },
  "crons": [
    { "path": "/api/task/notify?attn=digest", "schedule": "0 5 * * *" },
    { "path": "/api/task/notify?attn=digest", "schedule": "0 17 * * *" }
  ],
  "rewrites": [
    { "source": "/api/bot/webhook", "destination": "/api/bot/webhook.mjs" },
    { "source": "/api/github-webhook", "destination": "/api/github-webhook.mjs" },
    { "source": "/api/task/notify", "destination": "/api/task/notify.mjs" },
    { "source": "/api/intent/draft", "destination": "/api/intent/draft.mjs" },
    { "source": "/api/intent/poll", "destination": "/api/intent/poll.mjs" },
    { "source": "/api/relay/send", "destination": "/api/relay/send.mjs" },
    { "source": "/api/interview/start", "destination": "/api/interview/index.mjs" },
    { "source": "/api/interview/result", "destination": "/api/interview/index.mjs" },
    { "source": "/api/claude/question", "destination": "/api/claude/qna.mjs" },
    { "source": "/api/claude/answer", "destination": "/api/claude/qna.mjs" }
  ]
}
