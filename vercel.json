{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/bot/webhook.mjs": {
      "maxDuration": 10
    },
    "api/github-webhook.mjs": {
      "maxDuration": 10
    },
    "api/task/notify.mjs": {
      "maxDuration": 10
    },
    "api/intent/draft.mjs": {
      "maxDuration": 10
    },
    "api/intent/poll.mjs": {
      "maxDuration": 30
    },
    "api/relay/send.mjs": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/bot/webhook", "destination": "/api/bot/webhook.mjs" },
    { "source": "/api/github-webhook", "destination": "/api/github-webhook.mjs" },
    { "source": "/api/task/notify", "destination": "/api/task/notify.mjs" },
    { "source": "/api/intent/draft", "destination": "/api/intent/draft.mjs" },
    { "source": "/api/intent/poll", "destination": "/api/intent/poll.mjs" },
    { "source": "/api/relay/send", "destination": "/api/relay/send.mjs" }
  ]
}
